# Copie este arquivo para ".env" e preencha. O arquivo .env nunca vai para o GitHub.
# Gere um segredo forte com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Senha do banco de dados (Postgres)
POSTGRES_PASSWORD=
# Segredo que assina o login do painel (mínimo 32 caracteres)
SESSION_SECRET=

# Opcional: aviso de nova reserva no Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: porta do site neste computador (padrão 3000)
APP_PORT=3000
