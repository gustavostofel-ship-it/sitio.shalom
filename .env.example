# Copie este arquivo para ".env" e preencha. O arquivo .env nunca vai para o GitHub.
# Gere um segredo forte com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Senha do banco de dados (Postgres)
POSTGRES_PASSWORD=
# Segredo que assina o login do painel (mínimo 32 caracteres)
SESSION_SECRET=

# Endereço público do site, sem barra no fim. OBRIGATÓRIO no servidor (ex.: https://seudominio.com.br).
# É usado nos links de compartilhamento, no mapa do site e no robots.txt. No computador pode ficar vazio.
SITE_URL=

# Quantos proxies existem na frente do site (Easypanel/Traefik = 1). No computador, sem proxy, não importa.
# Serve para descobrir o IP real de quem acessa e limitar pedidos falsos.
PROXY_HOPS=1

# Opcional: aviso de nova reserva e de novo pedido de visita no Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: limites contra pedidos falsos (os valores abaixo já são os padrões)
# LIMITE_RESERVAS_IP=3          pedidos de reserva aguardando por origem (IP)
# LIMITE_RESERVAS_ABERTAS=12    pedidos de reserva do site aguardando, no total
# LIMITE_VISITAS_IP=3           pedidos de visita aguardando por origem (IP)
# LIMITE_VISITAS_ABERTAS=30     pedidos de visita aguardando, no total

# Opcional: porta do site neste computador (padrão 3000)
APP_PORT=3000
